# CardioInsight AI - environment configuration
# Copy this file to .env and fill in values as needed.
# Nothing below is a secret; the values are placeholders.

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
# Random seed for reproducible train/test splits and initialization.
CARDIOINSIGHT_RANDOM_SEED=42

# ---------------------------------------------------------------------------
# Dataset
# ---------------------------------------------------------------------------
# Path to the dataset CSV. Relative paths resolve from the project root.
# Leave empty to use the bundled synthetic dataset (see data/README.md).
CARDIOINSIGHT_DATA_PATH=

# ---------------------------------------------------------------------------
# Model engine
# ---------------------------------------------------------------------------
# "auto"   -> use scikit-learn if installed, else the pure-NumPy fallback
# "sklearn" -> force scikit-learn (fails loudly if unavailable)
# "numpy"   -> force the pure-NumPy fallback engine
CARDIOINSIGHT_MODEL_ENGINE=auto

# ---------------------------------------------------------------------------
# MLflow (optional - the app runs without it)
# ---------------------------------------------------------------------------
# Set to "true" to enable experiment tracking.
CARDIOINSIGHT_MLFLOW_ENABLED=false
# Tracking URI. "file://./mlruns" uses a local folder.
CARDIOINSIGHT_MLFLOW_TRACKING_URI=file://./mlruns
CARDIOINSIGHT_MLFLOW_EXPERIMENT=cardioinsight-heart-disease

# ---------------------------------------------------------------------------
# DVC (optional)
# ---------------------------------------------------------------------------
CARDIOINSIGHT_DVC_ENABLED=false

# ---------------------------------------------------------------------------
# Streamlit
# ---------------------------------------------------------------------------
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true